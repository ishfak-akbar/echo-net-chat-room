FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database (SQLite for dev, Postgres URL for production)
DATABASE_URL=sqlite:///echonet.db

# Server
HOST=127.0.0.1
PORT=5000

# Uploads
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,gif,webp

# Admin bootstrap (used only to create the first admin account, not a hardcoded login)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=set-a-strong-password-here